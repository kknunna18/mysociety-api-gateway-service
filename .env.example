# Required for all profiles. Use a high-entropy value of at least 32 characters.
JWT_HMAC_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional local upstream overrides
IDENTITY_SERVICE_URL=http://localhost:8081
SOCIETY_SERVICE_URL=http://localhost:8082
REDIS_HOST=localhost
REDIS_PORT=6379

# Comma-separated browser origins. Keep this restrictive in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
